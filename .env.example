# Supabase — salin ke .env.local lalu isi dengan nilai project Anda.
# Biarkan kosong untuk menjalankan aplikasi dalam MODE MOCK (data contoh).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role hanya dipakai script server (jangan pernah di-expose ke browser).
SUPABASE_SERVICE_ROLE_KEY=
